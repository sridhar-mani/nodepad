# ── Google AdSense (optional — no ads until client id is set) ─────────────────
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx

# Web mode (browser tab)
NEXT_PUBLIC_ADSENSE_SLOT_ABOUT=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_EMPTY=0987654321
NEXT_PUBLIC_ADSENSE_SLOT_ANCHOR=1111111111
NEXT_PUBLIC_ADSENSE_SLOT_FEED=2222222222

# Installed PWA mode (native / fluid units — optional overrides)
NEXT_PUBLIC_ADSENSE_SLOT_ABOUT_NATIVE=
NEXT_PUBLIC_ADSENSE_SLOT_EMPTY_NATIVE=
# AdSense in-feed layout keys from your AdSense unit setup
NEXT_PUBLIC_ADSENSE_LAYOUT_ABOUT=-fb+5w+4e-db+86
NEXT_PUBLIC_ADSENSE_LAYOUT_EMPTY=-fb+5w+4e-db+86
NEXT_PUBLIC_ADSENSE_LAYOUT_FEED=-fb+5w+4e-db+86

# ── PropellerAds in-page push (installed app only, optional) ───────────────
NEXT_PUBLIC_PROPELLERADS_ZONE_ID=
